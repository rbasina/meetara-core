# Data directories (uncompressed - use compressed zip files instead)
downloads/          # Downloaded PDFs and documents (4.71 GB)
images/              # Extracted images from documents (3.61 GB) - use images.zip
data/                # Uploaded and exported data

# Compressed files for git (tracked via Git LFS)
# Note: These zip files are tracked in git using Git LFS
# vectorstore.zip - Compressed vectorstore (use scripts/compress_for_git.ps1)
# images.zip - Compressed images (use scripts/compress_for_git.ps1)

